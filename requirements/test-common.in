-r test-common-base.in

blockbuster
coverage
isal; python_version < "3.14" and implementation_name == "cpython" # no wheel for 3.14, no PyPy wheel for 1.8.0+
mypy; implementation_name == "cpython"
pytest-xdist
pytest_codspeed
python-on-whales; implementation_name == "cpython" # pydantic-core has no PyPy (pp80) wheels
trustme; platform_machine != "i686" and implementation_name == "cpython" # cryptography has no 32-bit or PyPy (pp80) wheels
zlib_ng
